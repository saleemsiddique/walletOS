# Base de datos (instancia postgres-ai, puerto 5433)
DATABASE_URL=postgresql+asyncpg://walletos:secret@localhost:5433/walletos_ai

# Infraestructura compartida
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://walletos:secret@localhost:5672

# Secretos compartidos entre servicios
INTERNAL_SECRET=
JWT_SECRET=

# Endpoints internos de otros servicios
WALLET_SERVICE_URL=http://localhost:3002
USER_SERVICE_URL=http://localhost:3001

# Selección de proveedor LLM por funcionalidad (openai | anthropic)
LLM_PROVIDER_CATEGORIZE=openai
LLM_PROVIDER_INSIGHTS=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_CATEGORIZE_MODEL=gpt-4o-mini
OPENAI_INSIGHTS_MODEL=gpt-4o-mini

# Anthropic (opcional, solo si algún LLM_PROVIDER_* es 'anthropic')
ANTHROPIC_API_KEY=

# AWS S3 (exports de PDFs)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=walletos-exports-dev

# Insights
INSIGHTS_HISTORY_WEEKS=8
INSIGHTS_CRON_HOUR_UTC=6
INSIGHTS_CRON_CONCURRENCY=10

# Servidor
PORT=3003
